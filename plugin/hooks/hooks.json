{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/src/sync.mts",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
